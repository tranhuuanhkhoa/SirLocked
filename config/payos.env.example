# Copy these entries into the existing repo-root .env. Never commit real keys.
# payOS uses real bank transfers; there is no separate sandbox.
PayOS__Enabled=false
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__FrontendUrl=http://localhost:5173
PayOS__ExpiryMinutes=15

# Sample prices only: VND -> in-game coins. Confirm before enabling real payments.
PayOS__Packages__0__Id=starter
PayOS__Packages__0__Amount=10000
PayOS__Packages__0__Coins=1000
PayOS__Packages__1__Id=detective
PayOS__Packages__1__Amount=50000
PayOS__Packages__1__Coins=5000
PayOS__Packages__2__Id=master
PayOS__Packages__2__Amount=100000
PayOS__Packages__2__Coins=10000
