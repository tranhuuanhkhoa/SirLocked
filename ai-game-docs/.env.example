MongoDb__ConnectionString=mongodb://localhost:27017
MongoDb__DatabaseName=SirLockedDb
MongoDb__UsersCollectionName=users
MongoDb__CasesCollectionName=gameCases
MongoDb__RoomsCollectionName=gameRooms
MongoDb__GameResultsCollectionName=gameResults
MongoDb__ActionLogsCollectionName=gameActionLogs
MongoDb__RoomChatMessagesCollectionName=roomChatMessages
MongoDb__AiCaseDraftsCollectionName=aiCaseDrafts
MongoDb__AiGenerationLogsCollectionName=aiGenerationLogs
MongoDb__GeneratedAssetsCollectionName=generatedAssets

Email__FrontendUrl=http://localhost:5173
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SenderEmail=
Email__SenderName=SirLocked
Email__Username=
Email__Password=
Cors__AllowedOrigins__0=http://localhost:5173
TrustedProxies__0=
Swagger__Enabled=false

CaseCache__AbsoluteExpirationSeconds=300
CaseCache__SlidingExpirationSeconds=60

GameplayV3__Enabled=true
AiCaseV3Preset__Enabled=true

# Playtest telemetry is off by default and only runs for V3 cases.
# The key must be at least 32 characters; outside Development the API refuses to start without it.
GameplayV3__PlaytestInstrumentationEnabled=false
Playtest__PseudonymKey=replace-with-at-least-32-characters
Playtest__RetentionDays=30

# Leave unset to follow the case: V3 requires both players to confirm, V1/V2 keep the single-player route.
Accusation__RequireConsensus=

# Test-only. Registrations skip email verification so scripts/e2e_smoke.py can reach gameplay
# without an inbox. Ignored entirely outside Development, so it cannot be turned on in a deployment.
Auth__AutoVerifyRegistrations=false

Jwt__Secret=replace-with-at-least-32-characters-local-secret
Jwt__Issuer=SirLocked
Jwt__Audience=SirLockedUsers
Jwt__ExpiryHours=12

OpenAI__ApiKey=
OpenAI__LogicModel=gpt-5.5
OpenAI__ImageModel=gpt-image-2
OpenAI__CutoutImageModel=gpt-image-1.5
OpenAI__BaseUrl=https://api.openai.com/v1
OpenAI__TimeoutSeconds=900

Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__Enabled=false
Cloudinary__Folder=sirlocked/cases

# Public AI case admission. Keep disabled for local/mock runs.
AiQuota__Enabled=false
AiQuota__MaxActiveDraftsPerUser=1
AiQuota__MaxCasesPerUserPerDay=1
AiQuota__EstimatedCaseCostUsd=0
AiQuota__GlobalBudgetUsd=0
