{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "FrontendUrl": "http://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:4173"
    ]
  },
  "TrustedProxies": [],
  "Swagger": {
    "Enabled": false
  },
  "CaseCache": {
    "AbsoluteExpirationSeconds": 300,
    "SlidingExpirationSeconds": 60
  },
  "GameplayV3": {
    "Enabled": true
  },
  "AiCaseV3Preset": {
    "Enabled": true
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "SirLockedDb",
    "UsersCollectionName": "users",
    "CasesCollectionName": "gameCases",
    "RoomsCollectionName": "gameRooms",
    "GameResultsCollectionName": "gameResults",
    "ActionLogsCollectionName": "gameActionLogs",
    "RoomChatMessagesCollectionName": "roomChatMessages",
    "AiCaseDraftsCollectionName": "aiCaseDrafts",
    "AiGenerationLogsCollectionName": "aiGenerationLogs",
    "GeneratedAssetsCollectionName": "generatedAssets",
    "EvidencePhotosCollectionName": "evidencePhotos"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "SirLocked",
    "Audience": "SirLockedUsers",
    "ExpiryHours": 12
  },
  "OpenAI": {
    "ApiKey": "",
    "LogicModel": "gpt-5.6-sol",
    "SemanticReviewModel": "",
    "ImageModel": "gpt-image-2",
    "CutoutImageModel": "gpt-image-1.5",
    "CharacterImageQuality": "high",
    "CharacterStyleReferencePath": "characters/mona-sprite.png",
    "CharacterStyleReferencePaths": [
      "players/holmes.png",
      "characters/mona-sprite.png",
      "characters/samuel-sprite.png",
      "characters/victor-sprite.png",
      "characters/eleanor-sprite.png"
    ],
    "BaseUrl": "https://api.openai.com/v1",
    "TimeoutSeconds": 900,
    "MaxConcurrentImageRequests": 2,
    "MaxConcurrentVisionRequests": 2,
    "AiDryRun": false,
    "MockAiResponses": false,
    "SkipAssetGeneration": false,
    "DisableAutoPublish": false,
    "GenerateJsonOnly": false,
    "ValidateOnly": false,
    "EnableBlindSolvabilityReview": false
  },
  "Cloudinary": {
    "Enabled": false,
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "Folder": "sirlocked/cases"
  },
  "AiQuota": {
    "Enabled": false,
    "MaxActiveDraftsPerUser": 1,
    "MaxCasesPerUserPerDay": 1,
    "EstimatedCaseCostUsd": 0,
    "GlobalBudgetUsd": 0
  }
}
