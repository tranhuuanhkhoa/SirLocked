{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "FrontendUrl": "http://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:4173"
    ]
  },
  "TrustedProxies": [],
  "Swagger": {
    "Enabled": false
  },
  "CaseCache": {
    "AbsoluteExpirationSeconds": 300,
    "SlidingExpirationSeconds": 60
  },
  "GameplayV3": {
    "Enabled": true
  },
  "Cutscene": {
    "Enabled": true,
    "AutoGenerateForPixelCases": true,
    "AutoApprove": false
  },
  "CaseCatalog": {
    "PixelOnly": true,
    "SeedPixelOnStartup": true
  },
  "AiCaseV3Preset": {
    "Enabled": true
  },
  "Chests": {
    "Prices": {
      "chest_np": { "Chest": 120, "Key": 180 },
      "chest_nb": { "Chest": 170, "Key": 250 },
      "chest_sm": { "Chest": 140, "Key": 210 }
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "SirLockedDb",
    "UsersCollectionName": "users",
    "CasesCollectionName": "gameCases",
    "RoomsCollectionName": "gameRooms",
    "GameResultsCollectionName": "gameResults",
    "ActionLogsCollectionName": "gameActionLogs",
    "RoomChatMessagesCollectionName": "roomChatMessages",
    "AiCaseDraftsCollectionName": "aiCaseDrafts",
    "AiGenerationLogsCollectionName": "aiGenerationLogs",
    "GeneratedAssetsCollectionName": "generatedAssets",
    "EvidencePhotosCollectionName": "evidencePhotos"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "SirLocked",
    "Audience": "SirLockedUsers",
    "ExpiryHours": 12
  },
  "AiGeneration": {
    "AiDryRun": false,
    "MockAiResponses": false,
    "SkipAssetGeneration": false,
    "DisableAutoPublish": false,
    "GenerateJsonOnly": false,
    "ValidateOnly": false,
    "EnableBlindSolvabilityReview": false
  },
  "Bridge": {
    "Key": "",
    "LeaseHours": 2,
    "RateLimitPerMinute": 240,
    "MaxAssetBytes": 5242880,
    "ExposeMockResponses": false,
    "AllowLocalAssetStorage": false
  },
  "Cloudinary": {
    "Enabled": false,
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "Folder": "sirlocked/cases"
  },
  "AiQuota": {
    "Enabled": false,
    "MaxActiveDraftsPerUser": 1,
    "MaxCasesPerUserPerDay": 1
  }
}
