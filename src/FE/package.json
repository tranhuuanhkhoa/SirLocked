{
  "name": "sirlocked-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cases": "node ./scripts/build-cases.mjs",
    "build:demo": "node ./scripts/build-cases.mjs --case ../BE/SeedData/V3/case-v3-broken-seal-en.json --case ../BE/SeedData/V3/case-v3-broken-seal-vi.json --case ../BE/SeedData/V3/case-point-click-night-ledger-en.json --case ../BE/SeedData/V3/case-point-click-night-ledger-vi.json",
    "test:assets": "node --test ./scripts/case-assets.test.mjs",
    "test:realtime": "node --test ./scripts/realtime-recovery.test.mjs",
    "test:guide": "node --test ./scripts/role-guide.test.mjs",
    "test:navigation": "node --test ./scripts/navigation.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:ui": "node ./tests/run-ui-smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "lucide": "^1.20.0",
    "phaser": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^6.3.5"
  }
}
